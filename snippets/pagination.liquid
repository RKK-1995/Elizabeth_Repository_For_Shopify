{% if pagination.pages >0 %}
    <div class="max-w-6xl">
        <nav class="flex justify-center py-8">
            {% if pagination.previous %}
                <a href="{{pagination.previous.url}}" class="border hover:bg-gray-500 px-3 py-2 rounded-md mr-2">{{pagination.previous.title}}</a>
            {% endif %}

            {% for part in pagination.parts  %}
                {% if part.is_link %}
                    <a href="{{part.url}}" class="border hover:bg-gray-500 px-3 py-2 rounded-md mr-2">{{part.title}}</a>
                {% else %}
                    <span class="border bg-gray-500 px-3 py-2 rounded-md mr-2">{{part.title}}</span>
                    
                {% endif %}
            {% endfor %}

            {% if pagination.next %}
                <a href="{{pagination.next.url}}" class="border hover:bg-gray-500 px-3 py-2 rounded-md mr-2">{{pagination.next.title}}</a>
            {% endif %}
        </nav>
    </div>
{% endif %}
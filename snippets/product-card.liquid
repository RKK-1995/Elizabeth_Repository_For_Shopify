  <div class="w-full py-6 px-3">
        <div class="bg-white overflow-hidden rounded-lg shadow-lg">
            <a href="{{prod.url}}" class="cursor-pointer">
                <div class="overflow-hidden">
                    {% if prod.featured_image %}
                        <img src="{{prod.featured_image | image_url }}" height="" width="" class="object-cover w-full h-full transition duration-1000 ease-in-out hover:scale-105 translate" alt="{{prod.featured_image.title}}">
                    {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'w-full h-64 object-cover bg-gray-100 ' }}
                    {% endif %}
                </div>
            </a>
            <div class="flex flex-col p-4">
                <a href="{{prod.url}}">{{prod.title |  truncate: 20}}</a>
                <div >{{prod.price |  money}}</div>
                {% if section.settings.showVendor %}
                    <div class="text-gray-500 text-sm">{{prod.vendor}}</div> 
                {% endif %}
            </div>
        </div>
    </div>
                    
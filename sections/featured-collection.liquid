<div class="flex flex-col items-center my-4">
    <h1 class="text-center text-3xl">{{section.settings.title}}</h1>
    <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-4 my-4">
            {% for product in section.settings.featured_collection.products limit:section.settings.prodCount %} 
                {% render 'product-card', prod:product %}
                {% else %}
                    {% comment %} {% for item in (1..4) %}
                        {% render 'product-card-placeholder' %}
                    {% endfor %} {% endcomment %}
            {% endfor %}
        </div>
    </div>
    
</div>


{% schema %}
{
    "name": "Featured collection",
    "tag": "section",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default":"Featured Collections"
        },
        {   
            "type": "collection",
            "id": "featured_collection",
            "label": "Collection"
        },
        {   
            "type": "number",
            "id": "prodCount",
            "label": "Max No.of Product to be shown",
            "default":4
        }
        ],
    "presets":[
        {
            "name": "Featured Collections"
        }
    ]

}
{% endschema %}
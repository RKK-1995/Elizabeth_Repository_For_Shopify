<div class="px-4 py-8"> 
    {% paginate collection.products by section.settings.perPage %}
        <div class="max-w-6xl mx-auto">
            <a href="{{routes.collections_url}}" class="flex text-sm text-gray-500 unerline">
                {% render 'icon-back' %}   
                <span>Back to Collections</span> 
            </a>
       </div>
        <h1 class="text-3xl text-center">{{collection.title}}</h1>

        <div class="max-w-6xl mx-auto">
            
                 {% for product in collection.products %}
                    <div class="grid grid-cols-1 md:grid-cols-3 ">
                        {% render 'product-card', prod:product %}
                    </div>
                {% else %}
                        <p class="my-3 py-3 text-center">There are no products in this collection</p> 
                {% endfor %}
        </div>
       
        {% render 'pagination', pagination:paginate %}
    {% endpaginate %}
</div>

{% schema %}
{
    "name": "Template collection",
    "tag": "section",
    "settings": [
        {
            "type": "range",
            "id": "perPage",
            "label": "Per page count",
            "default":3,
            "min": 1,
            "max": 12
        },{
            "type": "checkbox",
            "id":"showVendor",
            "label":"Show Vendor",
            "default":false
        }
        ]
}
{% endschema %}